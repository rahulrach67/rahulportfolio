n  templateUrl: './skills.component.html',\n  styleUrls: ['./skills.component.scss']\n})\nexport class SkillsComponent implements OnInit {\n  skills: Skill[] = [];\n  categories: string[] = [];\n  activeCategory = 'All';\n\n  constructor(private portfolioService: PortfolioService) { }\n\n  ngOnInit(): void {\n    this.skills = this.portfolioService.getSkills();\n    const cats = this.skills.map(s => s.category);\n    this.categories = ['All', ...Array.from(new Set(cats))];\n  }\n\n  get filteredSkills(): Skill[] {\n    if (this.activeCategory === 'All') return this.skills;\n    return this.skills.filter(s => s.category === this.activeCategory);\n  }\n\n  setCategory(cat: string) {\n    this.activeCategory = cat;\n  }\n}\n","<section class=\"skills\" id=\"skills\">\n  <div class=\"container\">\n    <div class=\"section-header\">\n      <p class=\"section-label\">02. Skills</p>\n      <h2 class=\"section-title\">Tech Stack</h2>\n      <p class=\"section-subtitle\">\n        A curated set of technologies I use to build reliable, scalable, and beautiful applications.\n      </p>\n    </div>\n\n    <!-- Category Filter -->\n    <div class=\"filter-tabs\">\n      <button\n        *ngFor=\"let cat of categories\"\n        [class.active]=\"activeCategory === cat\"\n        (click)=\"setCategory(cat)\">\n        {{ cat }}\n      </button>\n    </div>\n\n    <!-- Skills Grid -->\n    <div class=\"skills-grid\">\n      <div class=\"skill-item\" *ngFor=\"let skill of filteredSkills\">\n        <div class=\"skill-header\">\n          <span class=\"skill-name\">{{ skill.name }}</span>\n          <span class=\"skill-level\">{{ skill.level }}%</span>\n        </div>\n        <div class=\"skill-bar\">\n          <div class=\"skill-fill\" [style.width]=\"skill.level + '%'\"></div>\n        </div>\n        <span class=\"skill-category\">{{ skill.category }}</span>\n      </div>\n    </div>\n\n    <!-- Tools section -->\n    <div class=\"tools-section\">\n      <p class=\"tools-label\"