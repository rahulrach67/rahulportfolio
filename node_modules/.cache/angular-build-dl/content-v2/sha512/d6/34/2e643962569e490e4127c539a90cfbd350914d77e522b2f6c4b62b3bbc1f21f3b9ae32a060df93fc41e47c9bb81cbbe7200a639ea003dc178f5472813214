sComponent } from './components/projects/projects.component';\nimport { ContactComponent } from './components/contact/contact.component';\nimport { FooterComponent } from './components/footer/footer.component';\n\n@NgModule({\n  declarations: [\n    AppComponent,\n    NavbarComponent,\n    HeroComponent,\n    AboutComponent,\n    SkillsComponent,\n    ProjectsComponent,\n    ContactComponent,\n    FooterComponent\n  ],\n  imports: [\n    BrowserModule,\n    BrowserAnimationsModule,\n    AppRoutingModule,\n    FormsModule,\n    ReactiveFormsModule\n  ],\n  providers: [],\n  bootstrap: [AppComponent]\n})\nexport class AppModule { }\n","import { Component, OnInit } from '@angular/core';\n\n@Component({\n  selector: 'app-about',\n  templateUrl: './about.component.html',\n  styleUrls: ['./about.component.scss']\n})\nexport class AboutComponent implements OnInit {\n\n  stats = [\n    { value: '3+', label: 'Years Experience' },\n    { value: '30+', label: 'Projects Built' },\n    { value: '15+', label: 'Happy Clients' },\n    { value: '∞', label: 'Lines of Code' }\n  ];\n\n  constructor() { }\n  ngOnInit(): void { }\n}\n","<section class=\"about\" id=\"about\">\n  <div class=\"container\">\n    <div class=\"about-image-col\">\n      <div class=\"image-frame\">\n        <div class=\"image-inner\">\n          <img src=\"/assets/images/WhatsApp Image 2026-02-24 at 2.00.05 PM.jpg\" alt=\"Profile Image\"\n            class=\"profile-image\" <div class=\"about-image-col\">\n          <div class=\"image-frame\">\n            <div class=\"image-inner\">\n              <img src=\"YOUR_IMAGE_URL_HERE\" alt=\"Profile Image\" class=\"profile-image\" />\n            </div>\n\n            <div class=\"frame-border frame-border-top\"></div>\n            <div class=\"frame-border frame-border-right\"></div>\n          </div>\n\n          <div class=\"stats-grid\">\n            <div class=\"stat-card\" *ngFor=\"let stat of stats\">\n              <span class=\"stat-value\">{{ stat.value }}</span>\n              <span class=\"stat-label\">{{ stat.label }}</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"frame-border frame-border-top\"></div>\n      <div class=\"frame-border frame-border-right\"></div>\n    \n\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\" *ngFor=\"let stat of stats\">\n        <span class=\"stat-value\">{{ stat.value }}</span>\n        <span class=\"stat-label\">{{ stat.label }}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"about-text-col\">\n    <p class=\"section-label\">01. About Me</p>\n    <h2 class=\"section-title\">Who Am I?</h2>\n\n    <div class=\"about-paragraphs\">\n      <p>\n        I'm a <span class=\"highlight\">Full Stack Developer</span> based in India with a passion for\n        building products that live on the internet. I care deeply about\n        crafting experiences that are accessible, performant, and delightful.\n      </p>\n      <p>\n        My journey in software development started back in 2023, and since then,\n        I've worked across the full stack — from crafting pixel-perfect frontends\n        in <span class=\"highlight\">Angular</span> to architecting scalable backend systems with\n        <span class=\"highlight\">Node.js</span>.\n      </p>\n      <p>\n        When I'm not coding, I'm probably exploring new technologies,\n        contributing to open source, or writing about what I've learned.\n        I believe in clean code, thoughtful architecture, and building things\n        that matter.\n      </p>\n    </div>\n\n    <div class=\"about-tags\">\n      <span\n        *ngFor=\"let tag of ['Problem Solving', 'Clean Code', 'Open Source', 'System Design', 'Mentoring', 'Continuous Learning']\">\n        <span class=\"tag-hash\">#</span>{{ tag }}\n      </span>\n    </div>\n  </div>\n  </div>\n</section>","import { Component, OnInit } from '@angular/core';\nimport { FormBuilder, FormGroup, Validators } from '@angula